APP_NAME=MEBRANDING
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://app.mebranding.test
APP_TIMEZONE=Europe/Amsterdam

# Domeinen: website en portalen (één applicatie). Productie: mebranding.nl en app.mebranding.nl
SITE_DOMAIN=mebranding.test
APP_DOMAIN=app.mebranding.test

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Productie: MySQL 8.4 op de Forge-server. Lokaal mag sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mebranding
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Verzendmail. VOORSTEL: Postmark of Mailgun. Tot de keuze er is: log (mails komen in storage/logs).
# log lokaal; op de server gmail (via de Gmail API, de server mag niet via de mailpoorten versturen).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mebranding.nl"
MAIL_FROM_NAME="MEBRANDING"
POSTMARK_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

# Wie meldingen van nieuwe aanmeldingen krijgt
MEBRANDING_TEAM_EMAIL=info@mebranding.nl

VITE_APP_NAME="${APP_NAME}"

# Gmail van MEBRANDING in het portaal (docs/koppelen-gmail.md). De sleutel alleen in Forge, nooit in Git.
GMAIL_POSTVAKKEN=
GMAIL_SERVICE_ACCOUNT=
